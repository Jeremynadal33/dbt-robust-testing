// For format details, see https://aka.ms/devcontainer.json. For config options, see the
// README at: https://github.com/devcontainers/templates/tree/main/src/python
{
	"name": "dbt WorkshopContainer",
	// Or use a Dockerfile or Docker Compose file. More info: https://containers.dev/guide/dockerfile
	"image": "mcr.microsoft.com/devcontainers/python:1-3.12-bookworm",
	"features": {
		"ghcr.io/devcontainers/features/common-utils:2": {}
	},
	"customizations": {
		"vscode": {
			"extensions": [
                "mechatroner.rainbow-csv",
                "innoverio.vscode-dbt-power-user",
                "yzhang.markdown-all-in-one"            ],
			"settings": {
				"editor.tabSize": 4,
				"git.detectSubmodules": false,
				"files.associations": {
					"*.sql": "jinja-sql", // all .sql files
					//don't format models in `target/` dir
					"**/target/**": "",
					"**/<dbt-project-dir>/**/*.yaml": "jinja-yaml",
					"**/<dbt-project-dir>/**/*.yml": "jinja-yaml",
					"**/<dbt-project-dir>/**/docs/**/*.md": "jinja-md"
				}
			}
		}
	},

	// Features to add to the dev container. More info: https://containers.dev/features.
	// "features": {},

	// Use 'forwardPorts' to make a list of ports inside the container available locally.
	// "forwardPorts": [],

	// Use 'postCreateCommand' to run commands after the container is created.
	"postCreateCommand": "pip install uv && uv sync && curl https://install.duckdb.org | sh",

	// Configure tool-specific properties.
	// "customizations": {},

	// Uncomment to connect as root instead. More info: https://aka.ms/dev-containers-non-root.
	// "remoteUser": "root"

	"mounts": [
		"source=${localEnv:HOME}${localEnv:USERPROFILE}/.ssh,target=/home/vscode/.ssh,type=bind,consistency=cached"
    ]
}